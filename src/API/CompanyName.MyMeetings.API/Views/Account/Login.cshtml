@model CompanyName.MyMeetings.API.Modules.UserAccess.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign in</title>
    <style>
        body { font-family: sans-serif; max-width: 24rem; margin: 4rem auto; }
        label { display: block; margin-top: 1rem; }
        input[type=text], input[type=password] { width: 100%; padding: 0.4rem; }
        button { margin-top: 1.25rem; padding: 0.5rem 1rem; }
        .error { color: #b00020; }
    </style>
</head>
<body>
    <h1>Sign in</h1>
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <label>
            Username
            <input asp-for="Username" />
        </label>
        <label>
            Password
            <input asp-for="Password" />
        </label>
        <button type="submit">Sign in</button>
    </form>
</body>
</html>
